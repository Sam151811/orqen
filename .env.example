# ---------------------------------------------------------------------------
# Inference gateway: executes the model being audited.
# mock = fully offline, spends nothing. Dev default and demo fallback.
# ---------------------------------------------------------------------------
ORQEN_PROVIDER=mock
# ORQEN_PROVIDER=openai_compatible
# Any OpenAI-compatible gateway:
#   HF Inference Providers  https://router.huggingface.co/v1
#   Groq                    https://api.groq.com/openai/v1
#   Cerebras                https://api.cerebras.ai/v1
#   OpenRouter              https://openrouter.ai/api/v1
# ORQEN_BASE_URL=https://api.groq.com/openai/v1
# ORQEN_API_KEY=

# The audited model's IDENTITY is its HF id; the string the gateway wants is
# often different. Map one to the other here - the passport records the HF id.
# ORQEN_MODEL_ALIASES={"meta-llama/Llama-3.1-8B-Instruct":"llama-3.1-8b-instant"}

# ---------------------------------------------------------------------------
# Embeddings: output-divergence metrics and incident retrieval.
# ---------------------------------------------------------------------------
ORQEN_EMBED_PROVIDER=mock
# ORQEN_EMBED_PROVIDER=openai_compatible
# ORQEN_EMBED_BASE_URL=https://api.openai.com/v1
# ORQEN_EMBED_API_KEY=
# ORQEN_EMBED_MODEL=text-embedding-3-small
# 256 keeps the corpus scan fast on a fraction of a CPU. Providers that reject
# a dimensions parameter fall back to truncation automatically.
ORQEN_EMBED_DIM=256
# ORQEN_EMBED_REQUEST_DIM=0   # set if your provider errors on `dimensions`

# ---------------------------------------------------------------------------
# Budget guards. The deadline matters more than the call cap in production:
# without it an unreachable gateway becomes a multi-minute hung request.
# ---------------------------------------------------------------------------
# Replicate measurement. 1 = a single point estimate with no error bar.
# Set 3 for anything whose numbers will be quoted: a metric whose confidence
# interval spans its threshold is then reported as "no call" instead of being
# assigned to a side it cannot be shown to be on. Costs calls linearly.
ORQEN_REPEATS=1
ORQEN_REPLICATE_TEMP=0.7

ORQEN_MAX_CALLS=120
ORQEN_MAX_CONCURRENCY=6
ORQEN_CALL_TIMEOUT=30
ORQEN_RUN_DEADLINE=75
ORQEN_MAX_TOKENS=160

# ---------------------------------------------------------------------------
# Storage. DATABASE_URL wins when set; otherwise SQLite at ORQEN_DB.
# Free hosts have ephemeral disks, so anything deployed needs Postgres.
# ---------------------------------------------------------------------------
ORQEN_DB=orqen.db
# DATABASE_URL=postgresql://user:pass@host/db

# Pre-audited at boot so a judge's first click reads a row instead of running
# 48 model calls behind a cold start. Comma-separated.
# ORQEN_WARM_MODELS=meta-llama/Llama-3.1-8B-Instruct,mistralai/Mistral-7B-Instruct-v0.3

# ORQEN_CORPUS=data/incidents.embedded.json.gz
# ORQEN_SIM_FLOOR=0.20

# ---------------------------------------------------------------------------
# Public endpoint limits. An audit spends the operator's gateway credits, not
# the caller's; reads of stored passports are never limited.
# ---------------------------------------------------------------------------
ORQEN_AUDIT_LIMIT=6
ORQEN_AUDIT_WINDOW=3600
ORQEN_GLOBAL_AUDIT_LIMIT=60

# ---------------------------------------------------------------------------
# Attestation. Base64 Ed25519 seed; generate with `python -m orqen.attest`.
# Absent one, an ephemeral key is generated at start-up and every passport says
# its signature attests to nothing durable.
# ---------------------------------------------------------------------------
# ORQEN_SIGNING_KEY=
